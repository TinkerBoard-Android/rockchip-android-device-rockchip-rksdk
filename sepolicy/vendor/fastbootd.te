recovery_only(`
    #allow fastbootd self:capability { dac_read_search };
    allow fastbootd storage_config_prop:file { getattr map open read };
    allow fastbootd uboot_block_device:blk_file { ioctl open write };
    allow fastbootd sysfs:dir r_dir_perms;
    allow fastbootd sysfs_batteryinfo:dir r_dir_perms;
')
